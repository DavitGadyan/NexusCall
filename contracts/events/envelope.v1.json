{
  "$defs": {
    "ActorRef": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "user",
            "service",
            "system"
          ],
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "ActorRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "event_type": {
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Event Type",
      "type": "string"
    },
    "event_version": {
      "default": 1,
      "minimum": 1,
      "title": "Event Version",
      "type": "integer"
    },
    "occurred_at": {
      "format": "date-time",
      "title": "Occurred At",
      "type": "string"
    },
    "tenant_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Tenant Id"
    },
    "correlation_id": {
      "format": "uuid",
      "title": "Correlation Id",
      "type": "string"
    },
    "causation_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Causation Id"
    },
    "producer": {
      "maxLength": 64,
      "title": "Producer",
      "type": "string"
    },
    "actor": {
      "$ref": "#/$defs/ActorRef"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    }
  },
  "required": [
    "event_type",
    "correlation_id",
    "producer",
    "actor"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
