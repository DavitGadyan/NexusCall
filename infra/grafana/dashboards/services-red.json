{
  "uid": "nexus-red", "title": "NexusCall — Services (RED)", "schemaVersion": 39, "time": { "from": "now-1h", "to": "now" },
  "templating": { "list": [ { "name": "service", "type": "query", "datasource": { "uid": "prom" },
    "query": "label_values(http_requests_total, service)", "includeAll": true, "multi": true } ] },
  "panels": [
    { "type": "timeseries", "title": "Requests / s", "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [ { "datasource": { "uid": "prom" }, "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\"}[5m]))" } ] },
    { "type": "timeseries", "title": "Error rate (5xx)", "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [ { "datasource": { "uid": "prom" }, "expr": "sum by (service) (rate(http_requests_total{service=~\"$service\",status=~\"5..\"}[5m]))" } ] },
    { "type": "timeseries", "title": "p95 latency", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [ { "datasource": { "uid": "prom" }, "expr": "histogram_quantile(0.95, sum by (le, service) (rate(http_request_duration_seconds_bucket{service=~\"$service\"}[5m])))" } ] },
    { "type": "timeseries", "title": "RabbitMQ queue depth", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [ { "datasource": { "uid": "prom" }, "expr": "sum by (queue) (rabbitmq_queue_messages)" } ] }
  ]
}
