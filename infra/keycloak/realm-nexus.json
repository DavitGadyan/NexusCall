{
  "realm": "nexus",
  "enabled": true,
  "displayName": "NexusCall (development)",
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "permanentLockout": false,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "eventsEnabled": true,
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "enabledEventTypes": [
    "LOGIN",
    "LOGIN_ERROR",
    "LOGOUT",
    "CODE_TO_TOKEN",
    "REFRESH_TOKEN_ERROR",
    "UPDATE_TOTP",
    "REMOVE_TOTP",
    "UPDATE_PASSWORD"
  ],
  "eventsExpiration": 2592000,
  "roles": {
    "realm": [
      {
        "name": "platform_owner",
        "description": "Platform owner (tightly controlled)"
      },
      {
        "name": "platform_operator",
        "description": "Platform operator"
      }
    ]
  },
  "clients": [
    {
      "clientId": "web-bff",
      "name": "NexusCall Web (BFF)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "secret": "${KC_WEB_BFF_CLIENT_SECRET}",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "${NEXUS_WEB_ORIGIN}/api/auth/callback"
      ],
      "webOrigins": [
        "${NEXUS_WEB_ORIGIN}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${NEXUS_WEB_ORIGIN}/",
        "acr.loa.map": "{\"aal1\": 1, \"aal2\": 2}",
        "default.acr.values": "aal1",
        "minimum.acr.value": "aal1",
        "access.token.lifespan": "300",
        "use.refresh.tokens": "true"
      },
      "authenticationFlowBindingOverrides": {
        "browser": "6d1b7a1e-0000-4000-8000-00000000f001"
      },
      "protocolMappers": [
        {
          "name": "nexus-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "nexus-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
