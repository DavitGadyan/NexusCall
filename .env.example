# NexusCall LOCAL DEVELOPMENT environment. Placeholders only — never put real credentials here.
# Create your local .env with random dev-only values:   make env
# (.env is gitignored. Staging/production secrets live in Vault and are injected at runtime.)

ENV=development
# fake = deterministic local simulators (refused by every service when ENV is staging/production)
PROVIDER_MODE=fake
NEXUS_PUBLIC_BASE_URL=http://localhost:47000
NEXUS_OIDC_PUBLIC_BASE=http://localhost:47080
NEXUS_OIDC_PUBLIC_ISSUER=http://localhost:47080/realms/nexus
OIDC_AUDIENCE=nexus-api
# Host ports (127.0.0.1 only). A dedicated range avoids clashing with other local stacks.
NEXUS_PORT_WEB=47000
NEXUS_PORT_KEYCLOAK=47080
NEXUS_PORT_POSTGRES=47432
NEXUS_PORT_VAULT=47200
NEXUS_PORT_RABBITMQ_UI=47672
NEXUS_PORT_MAILPIT=47025
NEXUS_PORT_GRAFANA=47001
NEXUS_PORT_S3=47900

# --- Dev-only generated secrets (make env fills these) ---
POSTGRES_BOOTSTRAP_PASSWORD=__generate__
NEXUS_DB_DEV_PASSWORD=__generate__
NEXUS_REDIS_DEV_PASSWORD=__generate__
RABBITMQ_DEFAULT_USER=nexus_admin
RABBITMQ_DEFAULT_PASS=__generate__
NEXUS_BROKER_DEV_PASSWORD=__generate__
VAULT_DEV_ROOT_TOKEN=__generate__
S3_DEV_ACCESS_KEY=nexusdevs3
S3_DEV_SECRET_KEY=__generate__
KC_BOOTSTRAP_ADMIN_USERNAME=kcadmin
KC_BOOTSTRAP_ADMIN_PASSWORD=__generate__
KC_DEV_USER_PASSWORD=__generate__
KC_DEV_SERVICE_CLIENT_SECRET=__generate__
KC_WEB_BFF_CLIENT_SECRET=__generate__
FAKE_PROVIDER_SECRET=__generate__
NEXUS_SESSION_KEY=__generate__
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=__generate__

# Optional: enable tracing export (requires the obs profile)
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Real provider sandbox credentials are NOT configured here. ---
# Add them through the UI (Integrations → Provider connections); they are written to Vault.
